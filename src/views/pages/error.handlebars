<div class="scanlines"></div>

<!-- Floating paw prints -->
<div id="pawFieldContainer"></div>

<!-- Clock -->
<div id="clockContainer"></div>

<!-- Main -->
<div class="container">
    <div class="error-code">{{errorCode}}</div>

    <div id="mascotContainer" class="mascot-wrapper">
        <div class="mascot-ring"></div>
        {{> mascot}}
    </div>

    <div class="title">{{title}}</div>
    <p class="subtitle">{{{subtitle}}}</p>

    <div id="punTickerContainer"></div>

    <!-- Pong game -->
    <div id="pongContainer"></div>

    <a class="home-btn" href="/">
        Take Me Home
    </a>
</div>
