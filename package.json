{
    "name": "webserver",
    "version": "1.0.0",
    "private": true,
    "description": "Error page server behind error.cerbrus.nl: one page per HTTP status code",
    "main": "dist/server/app.js",
    "scripts": {
        "start": "yarn build && node dist/server/app.js",
        "build": "tsc && node src/build.mjs",
        "dev": "node src/build.mjs --watch & tsx watch src/server/app.ts",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "type": "commonjs",
    "dependencies": {
        "express": "^5.2.1",
        "express-handlebars": "^9.0.1"
    },
    "devDependencies": {
        "@eslint/js": "^10",
        "@types/express": "^5.0.6",
        "@types/node": "^25.5.2",
        "@typescript-eslint/eslint-plugin": "8.58.1",
        "@typescript-eslint/parser": "8.58.1",
        "@typescript-eslint/utils": "^8.58.1",
        "chokidar": "^4.0.0",
        "esbuild": "^0.28.0",
        "esbuild-sass-plugin": "^3.7.0",
        "eslint": "~10.2.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import-x": "^4.18.1",
        "prettier": "^3.8.1",
        "sass": "^1.99.0",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2"
    }
}
