{
    "name": "webserver",
    "version": "1.0.0",
    "private": true,
    "description": "Error page server behind error.cerbrus.nl: one page per HTTP status code",
    "main": "dist/server/app.js",
    "scripts": {
        "start": "yarn build && node dist/server/app.js",
        "build": "tsc && node src/build.mjs",
        "dev": "node src/build.mjs --watch & tsx watch src/server/app.ts",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "type": "commonjs",
    "dependencies": {
        "express": "^5.3.0",
        "express-handlebars": "^9.0.6"
    },
    "devDependencies": {
        "@eslint/js": "^10",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.11",
        "@typescript-eslint/eslint-plugin": "8.74.0",
        "@typescript-eslint/parser": "8.74.0",
        "@typescript-eslint/utils": "^8.74.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "chokidar": "^6.0.0",
        "esbuild": "^0.28.2",
        "esbuild-sass-plugin": "^3.7.0",
        "eslint": "~10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.18.1",
        "prettier": "^3.10.1",
        "sass": "^1.108.2",
        "tsx": "^4.23.15",
        "typescript": "npm:@typescript/typescript6@^6.0.2"
    }
}
